{
  "_about": "Template PIM Phase 2 role catalogue and identity rules. Copy to Config/pim-phase2.catalogue.local.json (git-ignored) and edit for your programme: the scripts use the .local.json file when it exists. Trust levels follow a TL1 (highest) to TL4 model; entries marked Proposed or Open are drafts until agreed.",
  "Branding": {
    "PreparedBy": "Your organisation",
    "Programme": "PIM Phase 2",
    "Classification": "Confidential"
  },
  "TrustLevelBaselines": {
    "TL1": {
      "MaxActivationHours": 2,
      "ApprovalRequired": true,
      "MfaOrAuthContextRequired": true,
      "AuthContextTarget": true,
      "JustificationRequired": true,
      "PermanentActiveAllowed": false,
      "PermanentEligibleAllowed": false,
      "ReviewMonths": 3,
      "AssignmentPattern": "Direct eligible or single-purpose group; never an operational bundle"
    },
    "TL2": {
      "MaxActivationHours": 4,
      "ApprovalRequired": null,
      "MfaOrAuthContextRequired": true,
      "AuthContextTarget": true,
      "JustificationRequired": true,
      "PermanentActiveAllowed": false,
      "PermanentEligibleAllowed": false,
      "ReviewMonths": 6,
      "AssignmentPattern": "Tightly scoped service group or direct eligible"
    },
    "TL3": {
      "MaxActivationHours": 8,
      "ApprovalRequired": false,
      "MfaOrAuthContextRequired": true,
      "AuthContextTarget": false,
      "JustificationRequired": true,
      "PermanentActiveAllowed": false,
      "PermanentEligibleAllowed": null,
      "ReviewMonths": 12,
      "AssignmentPattern": "Approved operational bundle"
    },
    "TL4": {
      "MaxActivationHours": null,
      "ApprovalRequired": false,
      "MfaOrAuthContextRequired": false,
      "AuthContextTarget": false,
      "JustificationRequired": false,
      "PermanentActiveAllowed": true,
      "PermanentEligibleAllowed": true,
      "ReviewMonths": 12,
      "AssignmentPattern": "Standing read access acceptable"
    }
  },
