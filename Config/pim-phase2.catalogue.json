  "AzureSensitiveScopes": {
    "_about": "HLD 7.11.2: scopes holding identity, key management, security tooling, logging/SIEM, policy or automation services are TL1 at any scope for write-capable roles. Matched against subscription, resource group and resource names, and against resource types found in the resource group when the review account can read them.",
    "NamePatterns": [
      "(?i)sentinel",
      "(?i)siem",
      "(?i)securit(y|ies)",
      "(?i)identity",
      "(?i)\\badds\\b|aadds|domain.?controller",
      "(?i)(^|[-_])kv([-_]|$)|keyvault|key-vault",
      "(?i)automation",
      "(?i)\\bhsm\\b"
    ],
    "ResourceTypes": [
      "microsoft.keyvault/vaults",
      "microsoft.keyvault/managedhsms",
      "microsoft.securityinsights",
      "microsoft.operationalinsights/workspaces",
      "microsoft.automation/automationaccounts",
      "microsoft.aad/domainservices"
    ]
  },
